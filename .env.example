# ceibo — UN solo .env en la raíz del monorepo.
#
# Lo cargan los CUATRO procesos (gateway, web-server, oauth, mcps) con
# `process.loadEnvFile()`. Copialo a `.env` y completá lo que necesites:
#
#     cp .env.example .env
#
# ⚠️ `process.loadEnvFile()` PISA lo que venga del entorno del proceso. Por eso
#    PORT/HOST NO van acá (colisionarían entre servicios): viven en cada unit de
#    systemd. Ver packages/*/systemd/.
#
# Casi todo es opcional: cada subsistema se prende solo si sus variables están.
# Lo marcado [REQUERIDO] es lo mínimo para que el proceso arranque.
#
# Para generar secretos:  openssl rand -hex 32


# ─────────────────────────────────────────────────────────────────────────────
#  1. Núcleo — sin esto no arranca nada
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: dev | staging | prod. Determina el path de la DB, los puertos y qué
# tan estricta es la validación de arranque. Ausente o inválido = prod.
CEIBO_ENV=dev

# Ruta de la DB SQLite. Default: packages/store/data/ceibo[.<env>].db
# CEIBO_DB_PATH=/var/lib/ceibo/ceibo.db

# Zona horaria por defecto para crons, recordatorios y fechas que ve el agente.
DEFAULT_TZ=America/Argentina/Buenos_Aires


# ─────────────────────────────────────────────────────────────────────────────
#  2. Backend del agente
#
#  Dos backends intercambiables, elegibles POR USUARIO en la DB
#  (`ceibo user set-backend <handle> ma|local`):
#
#    ma    → Managed Agents cloud de Anthropic  (sección 2a)
#    local → un modelo propio vía archima       (sección 2b)
# ─────────────────────────────────────────────────────────────────────────────

# --- 2a. Managed Agents (cloud) ---
# [REQUERIDO por el gateway] Los tres primeros.
ANTHROPIC_API_KEY=
AGENT_ID=                  # agente principal (coordinador)
ENV_ID=                    # environment cloud

# Roster de sub-agentes: mismo agente, distinto modelo. `publish-agent` los crea
# en la 1ª corrida y loguea sus ids para pegarlos acá.
# AGENT_ID_LOW=            # trabajo masivo / mecánico
# AGENT_ID_MID=            # complejidad media
# AGENT_ID_HIGH=           # razonamiento pesado
# CHAT_TITLE_MODEL=        # modelo barato para titular conversaciones

# Límites de los sub-agentes (todos opcionales, con default sensato).
# SUBAGENT_MAX=            # cuántos sub-agentes en paralelo
# SUBAGENT_TIMEOUT_MS=
# SUBAGENT_ANNOUNCE_TIMEOUT_MS=
# SUBAGENT_SUMMARY_CAP=
# SUBAGENT_MAX_DELETIONS=  # tope de borrados que un sub-agente puede proponer

# --- 2b. archima (inferencia local sobre VMs libvirt) ---
# Sólo hace falta si algún usuario tiene backend_mode=local. Ver dev.md.
# ARCHIMA_SSH_TARGET=gpuhost-cp   # alias de ~/.ssh/config (usar IdentitiesOnly)
# ARCHIMA_SSH_KEY=                # ruta ABSOLUTA a la key (~ no expande en spawn)
# ARCHIMA_CP=                     # path del control-plane (cp.sh) en el host
# ARCHIMA_AV=                     # path del binario agent-vault
# ARCHIMA_MODEL_ID=
# ARCHIMA_PROVIDER_ID=
# ARCHIMA_COORDINATOR_MODEL_ID=
# ARCHIMA_WORKER_MODEL_ID=
# ARCHIMA_GEMMA_MODEL_ID=
# ARCHIMA_AGENT=                  # nombre del agente opencode (coordinador)
# ARCHIMA_WORKER_AGENT=
# ARCHIMA_VM_PORT=14420           # puerto de opencode serve dentro de la VM
# ARCHIMA_BOX_RUNTIME=            # raíz del runtime desplegado en el host
# ARCHIMA_TURN_TIMEOUT_MS=
# ARCHIMA_EXEC_TIMEOUT_MS=
# ARCHIMA_EVENT_IDLE_TIMEOUT_MS=
# ARCHIMA_MCP_CONCURRENCY=        # cuántos MCP conecta la VM a la vez
# ARCHIMA_MCP_PACE_MS=
# TAILSCALE_BIN=tailscale


# ─────────────────────────────────────────────────────────────────────────────
#  3. Web (SPA + SSE + login)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUERIDO por el web-server] Firma las cookies de sesión. openssl rand -hex 32
WEB_SESSION_KEY=

# [REQUERIDO por el web-server] Secreto del canal remoto web-server ⇄ gateway.
REMOTE_CHANNEL_SECRET=

# Origen público: arma los magic links y el redirect de Google Sign-In. Sin esto
# el login por mail y por Google devuelven 503.
# WEB_PUBLIC_ORIGIN=https://ceibo.example.com
# WEB_BASE_URL=https://ceibo.example.com

# WEB_PORT=8820            # default: 8820 (8821 en staging)
# WEB_BIND_HOST=127.0.0.1  # detrás del ingress
# WEB_STATIC_DIR=          # default: packages/web/dist
# REMOTE_CHANNEL_SOCK=     # unix socket; default derivado del entorno
# GATEWAY_SOCK=

# Login con Google: por default reusa el client del broker OAuth (sección 5).
# Estas dos permiten un client dedicado si algún día se separan.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Magic link por mail (Resend). Sin key, /api/auth/email/start devuelve 503.
# RESEND_API_KEY=
# MAIL_FROM=ceibo <hola@example.com>

# Foto de fondo de la web (Unsplash). Sin key, queda un color sólido.
# UNSPLASH_ACCESS_KEY=

# VITE_API_TARGET=http://127.0.0.1:8820   # sólo para `vite dev`


# ─────────────────────────────────────────────────────────────────────────────
#  4. Canales
# ─────────────────────────────────────────────────────────────────────────────

# Telegram. [REQUERIDO en prod por el gateway] — en dev es opcional.
TELEGRAM_BOT_TOKEN=        # de @BotFather
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_OWNER_ID=       # sólo siembra al owner en una DB NUEVA. El allowlist
#                          # real vive en channel_identities (`ceibo channel`).
# TELEGRAM_API_BASE_URL=   # para apuntar a un bot API server propio

# WhatsApp (vía el binario `wacli`). Todo opcional.
# WHATSAPP_BOT_ENABLED=1
# WHATSAPP_BOT_STORE=~/.wacli-ceibo/_bot
# WACLI_BIN=wacli
# WACLI_STORE_ROOT=~/.wacli-ceibo
# WACLI_DEVICE_LABEL=Ceibo
# WACLI_READ_TIMEOUT_MS=30000
# WACLI_FOLLOW_IDLE_MS=300000
# WACLI_BOOTSTRAP_MS=
# WACLI_ENROLL_WAIT_MS=
# WACLI_MEDIA_HOST=
# WACLI_MEDIA_TIMEOUT_MS=


# ─────────────────────────────────────────────────────────────────────────────
#  5. OAuth broker (conecta cuentas externas al agente)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUERIDO si usás el broker] Cifra los tokens at-rest (AES-256-GCM).
# 32 bytes en hex. Perderla = todos los grants ilegibles.
OAUTH_ENC_KEY=

# URL pública del servicio oauth + redirect EXACTO registrado en cada app.
# OAUTH_BASE_URL=https://ceibo.example.com
# OAUTH_REDIRECT_URI=https://ceibo.example.com/oauth/callback

# Provider Google (un client "Web" sirve para gmail/calendar/drive/sheets).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Provider Notion.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
#  6. MCP servers
#
#  Dos gates INDEPENDIENTES por server:
#    <NAME>_MCP_PATH_SECRET  → gatea la URL /mcp/<name>/<secret>. Va en la URL,
#                              así que se filtra en los access logs del proxy.
#    <NAME>_MCP_HMAC_KEY     → firma el Bearer de identidad por-usuario. NUNCA
#                              va en una URL. Sólo la usan los servers que
#                              distinguen usuarios (schedule, wacli, viewer,
#                              control, notes).
#
#  `<NAME>_MCP_SECRET` sigue funcionando como alias viejo de PATH_SECRET.
#  Un server se monta SÓLO si tiene su path-secret → poné los que quieras usar.
# ─────────────────────────────────────────────────────────────────────────────

# --- Stateless, servidos por el launcher (packages/mcps) en :8810 ---
# GMAIL_MCP_PATH_SECRET=
# CALENDAR_MCP_PATH_SECRET=
# DRIVE_MCP_PATH_SECRET=
# SHEETS_MCP_PATH_SECRET=
# NOTION_MCP_PATH_SECRET=
# SCHEDULE_MCP_PATH_SECRET=
# SCHEDULE_MCP_HMAC_KEY=
# WACLI_MCP_PATH_SECRET=
# WACLI_MCP_HMAC_KEY=

# --- In-process en el gateway ---
# CONTROL_MCP_SECRET=      # ⚠️ tiene que ir IDÉNTICO dentro de CONTROL_MCP_URL,
# CONTROL_MCP_HMAC_KEY=    #    o el gateway falla al arrancar.
# CONTROL_MCP_PORT=8830
# CONTROL_MCP_HOST=127.0.0.1
# NOTES_MCP_SECRET=        # ídem con NOTES_MCP_URL
# NOTES_MCP_HMAC_KEY=
# NOTES_MCP_PORT=8832
# NOTES_MCP_HOST=127.0.0.1

# --- In-process en el web-server ---
# VIEWER_MCP_SECRET=
# VIEWER_MCP_HMAC_KEY=

# --- URLs públicas (https://<host>/mcp/<server>/<path-secret>) ---
# Las lee el oauth al enrolar y el gateway al cablear el agente. Si falta
# alguna de las cinco de Google/Notion, `publish-agent` aborta en prod.
# GMAIL_MCP_URL=
# CALENDAR_MCP_URL=
# DRIVE_MCP_URL=
# SHEETS_MCP_URL=
# NOTION_MCP_URL=
# SCHEDULE_MCP_URL=
# WACLI_MCP_URL=
# CONTROL_MCP_URL=
# NOTES_MCP_URL=
# VIEWER_MCP_URL=

# Búsqueda web (MCP remoto de Tavily, no self-hosted).
# TAVILY_API_KEY=
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# SCHEDULER_TICK_MS=30000
# DAILY_CLEAR_ENABLED=
# DAILY_CLEAR_TICK_MS=
# DEV_NO_CONTROL_SERVE=1   # dev: no levantar el control MCP


# ─────────────────────────────────────────────────────────────────────────────
#  7. Wikis (substrato de notas sobre GitHub App)
# ─────────────────────────────────────────────────────────────────────────────

# Sin estas, el web-server arranca igual pero sin plano de notas.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_WIKIS_ORG=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem

# Modo de escritura de notas: "git" (el repo es la fuente) o "db" (la DB es la
# fuente y git queda como espejo de sólo-lectura).
# NOTES_WRITE_MODE=git
# NOTES_MIRROR=1           # 0 apaga el espejo git
# NOTES_INDEX=1            # 0 apaga el índice FTS + vectorial
# NOTES_FREEZE_FILE=       # touch/rm de este archivo congela las escrituras

# Embeddings para búsqueda semántica. Sin esto la búsqueda es sólo léxica (FTS).
# EMBED_URL=http://127.0.0.1:9000
# EMBED_MODEL=

# Sync de wikis hacia una VM de inferencia (proxy git scopeado).
# WIKI_SYNC_SECRET=        # HMAC del token de identidad de la VM
# WIKI_GIT_ALLOWED_IPS=    # allowlist de IPs, coma-separada. VACÍO = deniega TODO.
#                          # ⚠️ Se compara contra el ÚLTIMO hop de X-Forwarded-For:
#                          #    tu reverse proxy DEBE sobrescribir o apendear ese
#                          #    header, o es spoofeable. Ver SECURITY.md.
# WIKI_SYNC_URL=
# WIKI_SYNC_URL_LOCAL=
# WIKI_SYNC_TOKEN_FILE=
# WIKI_SYNC_WORKSPACE=
# WIKI_SYNC_STATE=


# ─────────────────────────────────────────────────────────────────────────────
#  8. Voz (STT/TTS) — opcional
#
#  Feature del bridge, no del modelo: transcribe lo que entra y sintetiza lo que
#  sale. Dos providers.
# ─────────────────────────────────────────────────────────────────────────────

# SPEECH_PROVIDER=local    # "local" (default) | "inworld"

# --- provider "local": gratis. faster-whisper + edge-tts en un venv Python. ---
# Se prende SÓLO si SPEECH_PYTHON está seteada.
# SPEECH_PYTHON=./.venv-speech/bin/python
# WHISPER_MODEL=base       # tiny | base | small
# WHISPER_COMPUTE=int8
# WHISPER_LANGUAGE=        # "" autodetecta; "es" fuerza español (más rápido)
# TTS_VOICE_DEFAULT=es-AR-ElenaNeural
# TTS_RATE_DEFAULT=

# --- provider "inworld": API HTTP paga. Se prende SÓLO con INWORLD_API_KEY. ---
# INWORLD_API_KEY=
# INWORLD_TTS_MODEL=
# INWORLD_STT_MODEL=
# INWORLD_VOICE_DEFAULT=
# INWORLD_BASE_URL=https://api.inworld.ai

# --- comunes ---
# FFMPEG_BIN=ffmpeg
# GS_BIN=gs                # ghostscript, para aplanar PDFs adjuntos
# STT_TIMEOUT_MS=120000
# TTS_TIMEOUT_MS=60000
# STT_CHUNK_SECONDS=
# STT_MIN_DURATION_MS=
# STT_SILENCE_DBFS=


# ─────────────────────────────────────────────────────────────────────────────
#  9. REM — consolidación batch de wikis (opcional, corre fuera del server)
# ─────────────────────────────────────────────────────────────────────────────

# REM_BATCH_SECRET=        # Bearer de sistema para /api/rem/{batch,report}
# REM_BATCH_BASE=
# REM_GIT_PROXY_BASE=
# REM_PUSH_TOKEN=
# REM_OPENCODE_BASE=http://127.0.0.1:4200
# REM_PLANNER_PROVIDER=vllm    # vllm | anthropic
# REM_PLANNER_MODEL=
# REM_PLANNER_TIMEOUT_MS=120000
# REM_EXECUTOR_TIMEOUT_MS=
# REM_GEMMA_MODEL=
# REM_VLLM_BASE=http://127.0.0.1:8000/v1
# REM_VLLM_KEY=
# REM_MAX_DELETIONS=       # tope de borrados por corrida (guardarraíl)
# REM_GIT_AUTHOR_NAME=
# REM_GIT_AUTHOR_EMAIL=
# REM_ENV_FILE=~/.config/ceibo/rem-batch.env


# ─────────────────────────────────────────────────────────────────────────────
#  10. Metering
# ─────────────────────────────────────────────────────────────────────────────

# CEIBO_BILLING_MARKUP=1   # multiplicador sobre el precio público para cost_usd
# CEIBO_DAY_TZ_OFFSET=     # offset de los buckets de `ceibo usage --daily`
