# Template unit para ceibo-webserver.
# %i = nombre de instancia (ej. "staging"). Instanciar como: ceibo-webserver@staging.service
#
# El web-server sirve la SPA (de ~/ceibo-%i/packages/web/dist) y los endpoints
# /api/* + SSE. Se conecta al gateway por el socket remoto derivado de CEIBO_ENV.
# Puerto: prod 8820, staging 8821 (derivado por ceiboEnv() en src/index.ts).
#
# Instalar en la box (como root):
#   sudo cp packages/web-server/systemd/ceibo-webserver@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ceibo-webserver@staging.service
#
# Logs:    journalctl -u ceibo-webserver@staging -f
# Restart: sudo systemctl restart ceibo-webserver@staging
#
# OJO tras cambios en packages/web: rebuild LIMPIO en la box antes del restart:
#   cd ~/ceibo-staging && rm -rf packages/web/dist && pnpm --filter @ceibo/web build

[Unit]
Description=ceibo web-server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy

WorkingDirectory=/home/deploy/ceibo-%i

EnvironmentFile=/home/deploy/ceibo-%i/.env.%i

Environment=CEIBO_ENV=%i

ExecStart=/bin/node /home/deploy/ceibo-%i/node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/cli.mjs packages/web-server/src/index.ts

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ceibo-webserver-%i

[Install]
WantedBy=multi-user.target
