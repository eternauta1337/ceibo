{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM",
      "options": {
        "baseURL": "http://192.168.122.1:8000/v1",
        "apiKey": "__VLLM_KEY__"
      },
      "models": {
        "gemma4-31b": {
          "name": "Gemma 4 31B",
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32000,
            "input": 24000,
            "output": 1024
          }
        }
      }
    },
    "local-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Qwen vLLM",
      "options": {
        "baseURL": "http://192.168.122.1:8001/v1",
        "apiKey": "__VLLM_KEY__"
      },
      "models": {
        "qwen7b": {
          "name": "Qwen 2.5 7B",
          "tool_call": true,
          "attachment": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 16384,
            "input": 10000,
            "output": 2048
          }
        }
      }
    },
    "local-gemma-lite": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Gemma Lite vLLM",
      "options": {
        "baseURL": "http://192.168.122.1:8002/v1",
        "apiKey": "__VLLM_KEY__"
      },
      "models": {
        "gemma4-e4b": {
          "name": "Gemma 4 E4B",
          "tool_call": true,
          "attachment": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 8192,
            "input": 6000,
            "output":  256
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "__ANTHROPIC_VAULT_REF__"
      }
    }
  },
  "model": "local/gemma4-31b",
  "compaction": {
    "auto": true,
    "reserved": 8000,
    "preserve_recent_tokens": 8000,
    "tail_turns": 4
  },
  "instructions": [
    "AGENTS.md"
  ],
  "tools": {
    "webfetch": false
  },
  "default_agent": "ceibo",
  "agent": {
    "ceibo": {
      "mode": "primary",
      "prompt": "{file:./ceibo.md}",
      "permission": {
        "*": "deny",
        "task": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "control*": "allow",
        "notes*": "allow",
        "schedule*": "allow",
        "viewer*": "allow",
        "gmail*": "allow",
        "calendar*": "allow",
        "drive*": "allow",
        "sheets*": "allow",
        "notion*": "allow",
        "wacli*": "allow",
        "tavily*": "allow"
      }
    },
    "ceibo-worker": {
      "mode": "subagent",
      "prompt": "{file:./ceibo-worker.md}",
      "permission": {
        "*": "allow",
        "task": "deny",
        "todowrite": "deny"
      }
    }
  }
}
