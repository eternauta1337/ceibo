# .env.dev.example — vars necesarias para correr Ceibo en dev local.
#
# Copiá este archivo como `.env` en el root del monorepo (NUNCA lo subas a git).
# Completá los valores marcados con TODO. Los demás tienen defaults razonables para dev.
#
# Guía completa: dev.md

# ── Entorno ─────────────────────────────────────────────────────────────────
CEIBO_ENV=dev

# ── Inferencia (Anthropic Managed Agents) ────────────────────────────────────
# Requeridos para que el gateway arranque y el chat funcione.
# Publicá los agentes dev con:
#   ENV_ID=ceibo-dev pnpm --filter @ceibo/gateway publish-agent
# Eso genera AGENT_ID_* y los agregás acá.
ANTHROPIC_API_KEY=sk-ant-TODO
ENV_ID=ceibo-dev
AGENT_ID=TODO                        # agente haiku de dev (publish-agent lo crea)
# AGENT_ID_SONNET=TODO               # opcional: agente sonnet de dev
# AGENT_ID_OPUS=TODO                 # opcional: agente opus de dev

# ── Web-server ───────────────────────────────────────────────────────────────
# Secreto de sesión: cualquier string largo y aleatorio vale para dev local.
WEB_SESSION_KEY=dev-session-key-local-solo-no-usar-en-prod

# Canal remoto (gateway ↔ web-server): cualquier string secret distinto al de prod.
REMOTE_CHANNEL_SECRET=dev-remote-channel-secret-local

# Origen público (para magic links, OAuth redirect URIs). En dev: localhost.
WEB_PUBLIC_ORIGIN=http://localhost:5173

# ── Telegram (OPCIONAL en dev) ───────────────────────────────────────────────
# En dev (web-only) Telegram NO es necesario. Si querés probarlo, descomentá:
# TELEGRAM_BOT_TOKEN=TODO

# ── GitHub App (wikis) ───────────────────────────────────────────────────────
# Opcional: sin esto el gateway arranca igual pero sin montaje de repos.
# Para usar wikis en dev necesitás una GitHub App propia (dev) y sus credenciales.
# GITHUB_APP_ID=TODO
# GITHUB_APP_PRIVATE_KEY=TODO
# GITHUB_APP_INSTALLATION_ID=TODO

# ── Google OAuth (login web) ──────────────────────────────────────────────────
# Opcional: sin esto el login web solo anda por email+password (el seed-dev lo setea).
# Registrá http://localhost:5173/api/auth/google/callback como redirect URI de dev.
# GOOGLE_CLIENT_ID=TODO
# GOOGLE_CLIENT_SECRET=TODO

# ── WhatsApp (siempre APAGADO en dev) ────────────────────────────────────────
# No setear WHATSAPP_BOT_ENABLED ni WACLI_* en dev: WhatsApp queda solo en prod.

# ── Backend de chat: ARCHIMA (alternativa a MA) ───────────────────────────────
# Por defecto el chat usa MA (AGENT_ID arriba). Para iterar sin gastar cuota MA
# podés redirigir el chat a archima (gemma local vía vLLM compartido).
#
# Pre-requisito: una key scopeada del control-plane de archima.
#   1. Copiá la key (pedísela al owner / bajala de la box) en:
#        ~/.ssh/archima_cp   (chmod 600)
#   2. Agregá a ~/.ssh/config (NECESARIO en la mac: fuerza la key correcta y evita
#      caer a otra key que salteé el forced-command wrapper):
#        Host gpuhost-cp
#            HostName 100.64.0.10
#            User demo
#            IdentityFile ~/.ssh/archima_cp
#            IdentitiesOnly yes
#   3. Descomentá las vars de abajo (y dejá AGENT_ID=dummy: archima no usa MA para
#      el chat, aunque ANTHROPIC_API_KEY sigue siendo necesaria para el bootstrap).
#   4. Flipeá el usuario dev a backend local:  ./ceibo user set-backend dev local
#
# Nota: las VMs ceibo-dev se crean solas en el 1er turno (cp.sh assign idempotente).
# Comparten el vLLM con prod/staging — contención aceptada para dev.
#
# ARCHIMA_SSH_TARGET=gpuhost-cp
# ARCHIMA_SSH_KEY=/Users/<usuario>/.ssh/archima_cp     # ruta ABSOLUTA (~ no expande en spawn)
# ARCHIMA_CP=cp.sh
# ARCHIMA_AV=agent-vault
# ARCHIMA_PROVIDER_ID=local
# ARCHIMA_MODEL_ID=gemma4-31b
